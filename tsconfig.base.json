{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true,
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2024",
    "customConditions": ["@codely/source"],
    "paths": {
      "@codely/shadcn": ["./libs/shadcn/src/index.ts"],
      "@codely/shadcn/utils": ["./libs/shadcn/src/lib/utils.ts"],
      "@codely/shadcn/ui/*": ["./libs/shadcn/src/ui/*"],
      "@codely/shadcn/lib/*": ["./libs/shadcn/src/lib/*"],
      "@codely/shadcn/hooks/*": ["./libs/shadcn/src/hooks/*"],
      "@codely/shared-types": ["./libs/shared-types/src/index.ts"],
      "@codely/shared-types/*": ["./libs/shared-types/src/*"],
      "@codely/feature-auth": ["./libs/feature-auth/src/index.ts"],
      "@codely/feature-auth/*": ["./libs/feature-auth/src/*"]
    }
  }
}
