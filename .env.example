# Cloudflare D1 — used by drizzle-kit (push/migrate/studio) in apps/codely/codely-service.
# Create the token at https://dash.cloudflare.com/profile/api-tokens with D1:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Where the Next.js app reaches the GraphQL worker.
# Defaults to the `wrangler dev` port (see apps/codely/codely-service/wrangler.jsonc).
CODELY_GRAPHQL_URL=http://127.0.0.1:4001
